# General
APP_RUNTIME_MODE=worker
BIND_HOST=0.0.0.0
PORT=8000
DASHBOARD_PAGE_SIZE=25
LOCAL_TIMEZONE=America/Chicago
CHECK_INTERVAL_MINUTES=5
LOG_LEVEL=INFO

# OAuth and Google API
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_OAUTH_PORT=8080

# Gmail
GMAIL_QUERY=in:inbox newer_than:14d
GMAIL_MAX_RESULTS=50
PROCESSED_MARKER_LABEL=Processed-By-AI-Agent

# Calendar
CALENDAR_ID=primary
DEFAULT_INTERVIEW_DURATION_MINUTES=60

# Cloud storage
# Supported: drive, local
STORAGE_PROVIDER=drive
DRIVE_ROOT_FOLDER=Job Search
LOCAL_BACKUP_DIR=./backup

# Optional experimental LLM classifier flag
ENABLE_LLM_CLASSIFIER=false
